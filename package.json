{
  "name": "contador-voltas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotenv -e .env.local -- tsx watch server/dev.ts",
    "dev:web": "vite",
    "generate": "zenstack generate",
    "db:push": "dotenv -e .env.local -- zenstack db push",
    "db:migrate": "dotenv -e .env.local -- zenstack migrate dev",
    "typecheck": "tsc",
    "build": "zenstack generate && tsc && vite build",
    "start": "dotenv -e .env.local -- tsx server/dev.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15",
    "@zenstackhq/orm": "^3.10.0",
    "@zenstackhq/plugin-policy": "^3.10.0",
    "dotenv": "^18.0.9",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@zenstackhq/cli": "^3.10.0",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^11.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.6"
  }
}
